
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Editar Criança — Clínica Pequenos Passos</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f8f9fa; display: flex; justify-content: center; padding-top: 40px; }
        .form-card { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.1); width: 420px; }
        h2 { margin-top: 0; color: #333; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; color: #555; }
        input, select { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
        .btn-group { margin-top: 20px; display: flex; justify-content: space-between; }
        button { padding: 10px 15px; background: #17a2b8; color: white; border: none; border-radius: 4px; cursor: pointer; }
        .btn-cancel { padding: 10px 15px; background: #6c757d; color: white; text-decoration: none; border-radius: 4px; font-size: 14px; }
    </style>
</head>
<body>
    <div class="form-card">
        <h2>Editar Criança</h2>
        <form action="/criancas/editar/<%= crianca.id %>" method="POST">
            <div class="form-group">
                <label>Nome da Criança:</label>
                <input type="text" name="nome" value="<%= crianca.nome %>" required>
            </div>

            <div class="form-group">
                <label>Data de Nascimento:</label>
                <input type="date" name="data_nascimento" value="<%= crianca.data_nascimento %>" required>
            </div>

            <div class="form-group">
                <label>Responsável:</label>
                <select name="responsavel_id" required>
                    <option value="">-- Selecione um Responsável --</option>
                    <% responsaveis.forEach(responsavel => { %>
                        <option value="<%= responsavel.id %>" <%= responsavel.id === crianca.responsavel_id ? 'selected' : '' %>>
                            <%= responsavel.nome %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="btn-group">
                <a href="/criancas" class="btn-cancel">Cancelar</a>
                <button type="submit">Atualizar Criança</button>
            </div>
        </form>
    </div>
</body>
</html>
